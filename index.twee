:: StoryStylesheet [stylesheet]
:root {
  font-size: 18px;
}

/*this part is for controller tags, tags that change specific functions or interactiable via tags*/

[tags~="textcenter"] {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

[tags~="slowtrans"] {
tw-transition-container {
  animation-duration: 5s !important;
  -webkit-animation-duration: 5s !important;
  }
}
/*This is the css for twine and its plugins harlowe*/

tw-story {
  font-size: 1rem;
}

tw-sidebar {
  display: none;
}

tw-passage {
  text-align: center;
}

tw-dialog {
  max-width: 800px;
}

/* notify.min.css, for Harlow Macro API, by Chapel */
#notify{position:fixed;display:block;width:16em;right:-20em;top:2em;padding:.5em;background-color:#fff;color:#000;font-family:Georgia,serif;font-size:16px;-webkit-transition:right .3s;transition:right .3s;z-index:10000}#notify.open{right:0}
/* end notify.min.css*/

